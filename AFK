-- ระบบลากเลื่อนหน้าจอ (Draggable สำหรับมือถือและคอมพิวเตอร์)
local dragging, dragInput, dragStart, startPos

TopBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = MainFrame.Position
        
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        if dragging then
            local delta = input.Position - dragStart
            MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end
end)

-- ระบบย่อ/ขยายหน้าต่าง (Minimize / Maximize)
local isMinimized = false
MinimizeButton.MouseButton1Click:Connect(function()
    isMinimized = not isMinimized
    if isMinimized then
        MinimizeButton.Text = "+"
        Container.Visible = false
        MainFrame:TweenSize(UDim2.new(0, 320, 0, 45), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.2, true)
    else
        MinimizeButton.Text = "-"
        Container.Visible = true
        MainFrame:TweenSize(UDim2.new(0, 320, 0, 420), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.2, true)
    end
end)

-- ระบบการทำงาน Anti-AFK
local isAFK = false
local afkConnection = nil

ToggleButton.MouseButton1Click:Connect(function()
    isAFK = not isAFK
    if isAFK then
        ToggleButton.BackgroundColor3 = Color3.fromRGB(255, 60, 60)
        ToggleButton.Text = "DISABLE AFK MODE\n(ปิดใช้งาน)"
        StatusBox.Text = "Status: AFK Active!\nระบบกำลังทำงาน ป้องกันการโดนเตะออกจากเกม..."
        
        afkConnection = LocalPlayer.Idled:Connect(function()
            VirtualUser:CaptureController()
            VirtualUser:ClickButton2(Vector2.new())
            StatusBox.Text = "Status: Anti-AFK Triggered!\n(" .. os.date("%X") .. ")"
        end)
    else
        ToggleButton.BackgroundColor3 = Color3.fromRGB(0, 170, 255)
        ToggleButton.Text = "ENABLE AFK MODE\n(เปิดใช้งาน)"
        StatusBox.Text = "Status: Stopped\nหยุดการทำงานเรียบร้อย"
        
        if afkConnection then
            afkConnection:Disconnect()
            afkConnection = nil
        end
    end
end)
